----- 8. funcion ingreso cliente
-- suma total gastado por cliente en pedidos entregados
delimiter //
create function fn_ingreso_cliente(p_cliente_id int)
returns decimal(12,2)
deterministic
begin
    declare v_total decimal(12,2);

    select sum(p.cantidad * pr.precio)
    into v_total
    from pedidos p
    join productos pr on p.producto_id = pr.producto_id
    where p.cliente_id = p_cliente_id
    and p.estado = "entregado";

    return ifnull(v_total,0);
end //
delimiter ;

-- uso de la funcion
select nombre, ciudad, fn_ingreso_cliente(cliente_id) as ingreso_total
from clientes
order by ingreso_total desc;


----- 9. funcion stock suficiente
-- valida si hay stock suficiente
delimiter //
create function fn_stock_suficiente(p_producto_id int, p_cantidad int)
returns int
deterministic
begin
    declare v_stock int;

    select stock into v_stock
    from productos
    where producto_id = p_producto_id;

    if v_stock >= p_cantidad then
        return 1;
    else
        return 0;
    end if;
end //
delimiter ;

select nombre, stock
from productos
where fn_stock_suficiente(producto_id,5) = 0;


----- 10. procedimiento actualizar estado pedido
-- cambia estado y guarda historial
delimiter //
create procedure sp_actualizar_estado_pedido(p_id int, p_estado varchar(20))
begin
    declare v_estado varchar(20);

    -- obtener estado actual
    select estado into v_estado
    from pedidos
    where pedido_id = p_id;

    -- guardar cambio en log
    insert into log_cambios_estado(pedido_id,estado_anterior,estado_nuevo)
    values(p_id,v_estado,p_estado);

    -- actualizar estado
    update pedidos
    set estado = p_estado
    where pedido_id = p_id;

    -- si se cancela, devolver stock
    if p_estado = "cancelado" then
        update productos pr
        join pedidos p on pr.producto_id = p.producto_id
        set pr.stock = pr.stock + p.cantidad
        where p.pedido_id = p_id;
    end if;
end //
delimiter ;


----- 11. procedimiento resumen cliente
-- resumen de pedidos por estado + ingreso
delimiter //
create procedure sp_resumen_cliente(p_id int)
begin
    select c.nombre, c.ciudad,
    sum(case when p.estado="entregado" then 1 else 0 end) entregados,
    sum(case when p.estado="pendiente" then 1 else 0 end) pendientes,
    sum(case when p.estado="cancelado" then 1 else 0 end) cancelados,
    sum(case when p.estado="entregado" then p.cantidad*pr.precio else 0 end) ingreso
    from clientes c
    left join pedidos p on c.cliente_id = p.cliente_id
    left join productos pr on p.producto_id = pr.producto_id
    where c.cliente_id = p_id
    group by c.cliente_id;
end //
delimiter ;


----- 12. vista pedidos pendientes y procedimiento alerta
-- vista con dias de espera
create view vista_pedidos_pendientes as
select p.pedido_id, c.nombre, pr.nombre, p.cantidad, pr.precio,
datediff(curdate(),p.fecha_pedido) as dias
from pedidos p
join clientes c on p.cliente_id = c.cliente_id
join productos pr on p.producto_id = pr.producto_id
where p.estado = "pendiente";

-- procedimiento para filtrar retrasos
delimiter //
create procedure sp_alertar_retrasos(p_dias int)
begin
    select * from vista_pedidos_pendientes
    where dias > p_dias;
end //
delimiter ;


----- 13. columna descuento y funcion precio final
-- agregar descuento
alter table productos add column descuento decimal(5,2) default 0;

-- calcular precio final con descuento
delimiter //
create function fn_precio_final(p_id int)
returns decimal(10,2)
deterministic
begin
    declare v_precio decimal(10,2);
    declare v_desc decimal(5,2);

    select precio, descuento into v_precio, v_desc
    from productos
    where producto_id = p_id;

    return v_precio * (1 - v_desc/100);
end //
delimiter ;

select nombre, precio, descuento, fn_precio_final(producto_id) as final
from productos
order by final desc
limit 3;


----- 14. procedimiento registrar pedido
-- crea pedido y descuenta stock
delimiter //
create procedure sp_registrar_pedido(p_cliente int, p_producto int, p_cant int)
begin
    insert into pedidos(cliente_id,producto_id,cantidad,estado)
    values(p_cliente,p_producto,p_cant,"pendiente");

    update productos
    set stock = stock - p_cant
    where producto_id = p_producto;

    select c.nombre, pr.nombre, p.cantidad
    from pedidos p
    join clientes c on p.cliente_id = c.cliente_id
    join productos pr on p.producto_id = pr.producto_id
    order by p.pedido_id desc
    limit 1;
end //
delimiter ;


----- 15. funcion clasificar producto y vista
-- clasifica productos por precio
delimiter //
create function fn_clasificar_producto(p_id int)
returns varchar(20)
deterministic
begin
    declare v_precio decimal(10,2);

    select precio into v_precio
    from productos
    where producto_id = p_id;

    if v_precio > 1000000 then return "premium";
    elseif v_precio >= 200000 then return "estandar";
    else return "basico";
    end if;
end //
delimiter ;

create view vista_catalogo_clasificado as
select nombre, categoria, precio,
fn_clasificar_producto(producto_id) as clasificacion, stock
from productos;

select * from vista_catalogo_clasificado
where clasificacion = "premium" and stock > 5;


----- 16. vista clientes vip y consulta detalle
-- clientes con más pedidos que el promedio
create view vista_clientes_vip as
select c.cliente_id, c.nombre, c.ciudad,
count(*) as total
from pedidos p
join clientes c on p.cliente_id = c.cliente_id
where p.estado = "entregado"
group by c.cliente_id
having count(*) > (
    select avg(t.c)
    from (
        select count(*) as c
        from pedidos
        where estado="entregado"
        group by cliente_id
    ) t
);

-- detalle de pedidos de clientes VIP
select c.nombre, pr.nombre, p.fecha_pedido
from vista_clientes_vip v
join pedidos p on v.cliente_id = p.cliente_id
join productos pr on p.producto_id = pr.producto_id
join clientes c on c.cliente_id = v.cliente_id
order by p.fecha_pedido desc;

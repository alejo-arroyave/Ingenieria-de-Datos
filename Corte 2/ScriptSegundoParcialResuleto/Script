----- 4. update con subconsulta y delete con not exists
-- aumentar precio si stock < promedio de su categoria
update productos pr
set precio = precio * 1.08
where stock < (
    select avg(p2.stock)
    from productos p2
    where p2.categoria = pr.categoria
);

-- eliminar pedidos cancelados sin pedidos entregados del cliente
delete from pedidos p
where estado = "cancelado"
and not exists (
    select 1
    from pedidos p2
    where p2.cliente_id = p.cliente_id
    and p2.estado = "entregado"
);



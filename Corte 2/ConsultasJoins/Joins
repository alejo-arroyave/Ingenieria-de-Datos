### Tarea: MOSTRAR EL DETALLE COMPLETO DE LOS PEDIDOS (cliente que pedido tiene y qué productos compró)
/*
select columnas
from tabla1 alias1
join tabla2 alias2 on alias1.campo = alias2.campo;
*/
select 
    c.nombrecliente,
    p.id_pedido,
    p.fecha_pedido,
    pr.nombreproducto,
    dp.cantidad,
    dp.precio_unit,
    (dp.cantidad * dp.precio_unit) as total
from pedido p
join clientes c on p.id_cliente = c.id_cliente
join detalle_pedido dp on p.id_pedido = dp.id_pedido
join productos pr on dp.id_producto = pr.idproducto
order by p.id_pedido asc;

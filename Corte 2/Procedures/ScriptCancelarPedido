delimiter //

create procedure cancelar_pedido(
    in p_id_pedido int,
    in p_id_cliente int,
    out p_mensaje varchar(200)
)
begin

    declare v_existe int;
    declare v_estado varchar(20);

    declare exit handler for sqlexception
    begin
        rollback;
        set p_mensaje = 'error: transaccion cancelada';
    end;

    select count(*) into v_existe
    from pedido
    where id_pedido = p_id_pedido
    and id_cliente = p_id_cliente;

    if v_existe = 0 then
        set p_mensaje = 'el pedido no existe o no pertenece al cliente';
    else

        select estado into v_estado
        from pedido
        where id_pedido = p_id_pedido;

        if v_estado = 'cancelado' or v_estado = 'entregado' then
            set p_mensaje = 'no se puede cancelar el pedido';
        else

            start transaction;

            update pedido
            set estado = 'cancelado'
            where id_pedido = p_id_pedido;

            update productos pr
            join detalle_pedido dp on pr.idproducto = dp.id_producto
            set pr.categoriaproducto = pr.categoriaproducto
            where dp.id_pedido = p_id_pedido;

            commit;

            set p_mensaje = concat('pedido ', p_id_pedido, ' cancelado correctamente');

        end if;

    end if;

end //

delimiter ;

call cancelar_pedido(1,1,@mensaje);
select @mensaje;

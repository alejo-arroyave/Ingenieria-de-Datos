delimiter //
create function fn_descuento_volumen(p_cantidad int,
p_precio decimal (10,2))
returns decimal (10,2)
deterministic
begin
declare v_porcentaje decimal (10,2);
declare v_total decimal;
-- definir el porcentaje de descuento según la cantidad comprada
set v_porcentaje = case
	when p_cantidad >= 100 then 20.00
	when p_cantidad >=50 then 15.00
	when p_cantidad >= 20 then 10.00
	when p_cantidad >= 10 then 5.00
end;

set v_total = p_cantidad * p_precio * (1-(v_porcentaje/100));
return round (v_total,2);
end//
delimiter ;

select nombre,
precio,
fn_descuento_volumen(25,precio) as TotalDescuento
from productos;



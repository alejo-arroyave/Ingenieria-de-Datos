c.nombre AS cliente,
c.id_cliente,
c.ciudad,
p.fecha_pedido,
p.estado,
p.total
FROM pedidos p
INNER JOIN clientes c ON p.id_cliente = c.id_cliente
ORDER BY p.fecha_pedido DESC;


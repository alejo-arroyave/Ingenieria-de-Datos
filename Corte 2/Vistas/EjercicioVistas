c.nombre AS cliente,
c.id_cliente,
c.ciudad,
COUNT(p.id_pedido) AS totalPedido
FROM clientes c
LEFT JOIN pedidos p ON c.id_cliente = p.id_cliente
GROUP BY c.id_cliente;

-- Join con 3 tablas
SELECT
c.nombre AS cliente,
p.id_pedido,
p.estado,
pr.nombre AS producto,
dp.cantidad,
dp.precio_unit,
(dp.cantidad * dp.precio_unit) AS subtotal
FROM clientes c
INNER JOIN pedidos p ON c.id_cliente = p.id_cliente
INNER JOIN detalle_pedido dp ON p.id_pedido = dp.id_pedido
INNER JOIN productos pr ON dp.id_producto = pr.id_producto
ORDER BY c.nombre, p.id_pedido;

-- =========================================
-- PROCEDIMIENTO: CREAR PEDIDO
-- =========================================

DELIMITER //

CREATE PROCEDURE sp_crear_pedido(
    IN  p_id_cliente  INT,
    IN  p_id_producto INT,
    IN  p_cantidad    INT,
    OUT p_id_pedido   INT,
    OUT p_mensaje     VARCHAR(200)
)
BEGIN
    DECLARE v_stock   INT;
    DECLARE v_precio  DECIMAL(10,2);
    DECLARE v_total   DECIMAL(12,2);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_mensaje = 'Error: transacción revertida';
        SET p_id_pedido = -1;
    END;

    SELECT stock, precio INTO v_stock, v_precio
    FROM productos WHERE id_producto = p_id_producto;

    IF v_stock < p_cantidad THEN
        SET p_mensaje = 'Stock insuficiente';
        SET p_id_pedido = 0;
    ELSE
        START TRANSACTION;

        SET v_total = v_precio * p_cantidad;

        INSERT INTO pedidos(id_cliente, total)
        VALUES (p_id_cliente, v_total);

        SET p_id_pedido = LAST_INSERT_ID();

        INSERT INTO detalle_pedido(id_pedido, id_producto, cantidad, precio_unit)
        VALUES (p_id_pedido, p_id_producto, p_cantidad, v_precio);

        UPDATE productos
        SET stock = stock - p_cantidad
        WHERE id_producto = p_id_producto;

        COMMIT;

        SET p_mensaje = CONCAT('Pedido #', p_id_pedido, ' creado');
    END IF;
END //

DELIMITER ;

-- =========================================
-- PROCEDIMIENTO CON CURSOR
-- =========================================

DELIMITER //

CREATE PROCEDURE sp_resumen_pedido_cursor(
    IN p_id_pedido INT,
    OUT p_total_productos INT,
    OUT p_mensaje VARCHAR(200)
)
BEGIN
    DECLARE done INT DEFAULT 0;
    DECLARE v_cantidad INT;
    DECLARE v_total INT DEFAULT 0;

    DECLARE cur CURSOR FOR
        SELECT cantidad FROM detalle_pedido WHERE id_pedido = p_id_pedido;

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    OPEN cur;

    loop_cursor: LOOP
        FETCH cur INTO v_cantidad;
        IF done = 1 THEN LEAVE loop_cursor; END IF;
        SET v_total = v_total + v_cantidad;
    END LOOP;

    CLOSE cur;

    SET p_total_productos = v_total;
    SET p_mensaje = CONCAT('Total productos: ', v_total);
END //

DELIMITER ;

-- =========================================
-- PROCEDIMIENTO: CANCELAR PEDIDO
-- =========================================

DELIMITER //

CREATE PROCEDURE sp_cancelar_pedido(
    IN  p_id_cliente INT,
    IN  p_id_pedido INT,
    OUT p_mensaje VARCHAR(200)
)
BEGIN
    DECLARE v_estado VARCHAR(20);
    DECLARE v_id_cliente INT;
    DECLARE v_num_productos INT;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_mensaje = 'Error: transacción revertida';
    END;

    SELECT estado, id_cliente INTO v_estado, v_id_cliente
    FROM pedidos WHERE id_pedido = p_id_pedido;

    IF v_id_cliente IS NULL THEN 
        SET p_mensaje = 'Error: pedido no existe';
    ELSEIF v_id_cliente <> p_id_cliente THEN
        SET p_mensaje = 'Error: no pertenece al cliente';
    ELSEIF v_estado IN ('cancelado','entregado') THEN
        SET p_mensaje = 'No se puede cancelar';
    ELSE
        START TRANSACTION;

        UPDATE productos pr
        JOIN detalle_pedido dp ON pr.id_producto = dp.id_producto
        SET pr.stock = pr.stock + dp.cantidad
        WHERE dp.id_pedido = p_id_pedido;

        SELECT COUNT(*) INTO v_num_productos
        FROM detalle_pedido
        WHERE id_pedido = p_id_pedido;

        UPDATE pedidos
        SET estado = 'cancelado'
        WHERE id_pedido = p_id_pedido;

        COMMIT;

        SET p_mensaje = CONCAT('Pedido #', p_id_pedido, ' cancelado correctamente');
    END IF;
END //

DELIMITER ;

